{
  "name": "autoge-car-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "import:events": "node --import tsx src/cli/import-events.ts",
    "import:events:sqlite": "node --import tsx src/cli/import-events-sqlite.ts",
    "registry:generate": "node --import tsx src/cli/offer-registry.ts",
    "registry:check": "node --import tsx src/cli/offer-registry.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run registry:check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "tsx": "4.23.9",
    "vitest": "4.1.10"
  }
}
