# Game connection
PLAYER_ID=094gdi
GAME_ID=7zav
GAME_API_URL=http://172.16.1.190:8000
OPENAPI_URL=http://172.16.1.190:8000/openapi.json

# Auth — event mode (competition default): X-Player-Id, no token needed
AUTH_MODE=event
GAME_API_TOKEN=your-token-here
GAME_API_AUTH_HEADER=Authorization

# Local gateway (policies/pollers connect here, not to GAME_API_URL)
GATEWAY_PORT=3100
GATEWAY_HOST=127.0.0.1

# PostgreSQL (matches game/docker-compose.yml — postgres:1.15)
DATABASE_URL=postgresql://game:game@localhost:5432/game

# Rate limiting
POLL_INTERVAL_MS=2000
POLL_MAX_RPS=2
GATEWAY_MAX_BODY_BYTES=65536

# Policy runner
POLICY_TICK_INTERVAL_MS=1000
DRY_RUN=false
