{
  "upstreamBaseUrl": "${GAME_API_URL}",
  "authHeader": "${GAME_API_AUTH_HEADER}",
  "stateEndpoints": [
    {
      "key": "flags",
      "method": "GET",
      "path": "/api/v1/flags?game_id=${GAME_ID}",
      "limitKey": "get_flags",
      "pollIntervalMs": 5000
    },
    {
      "key": "map",
      "method": "GET",
      "path": "/api/v1/map?game_id=${GAME_ID}",
      "streamPath": "/api/v1/games/${GAME_ID}/map/stream",
      "limitKey": "get_map",
      "pollIntervalMs": 5000
    },
    {
      "key": "leaderboard",
      "method": "GET",
      "path": "/api/v1/leaderboard?game_id=${GAME_ID}",
      "limitKey": "get_leaderboard",
      "pollIntervalMs": 3000
    }
  ]
}
